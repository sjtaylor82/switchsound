<Window x:Class="SwitchSound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchSound" Width="500" Height="305" MinWidth="440" MinHeight="285"
        WindowStartupLocation="CenterScreen" Background="#111827" Foreground="#F9FAFB"
        AutomationProperties.Name="SwitchSound audio output selector">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F9FAFB"/></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="#F9FAFB"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,6"/></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="SwitchSound" FontSize="26" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,20" Text="Select an output, or press Control+Backslash to switch to the next one."
                   Foreground="#D1D5DB"/>
        <Label Grid.Row="2" Content="Audio _output" Target="{Binding ElementName=OutputBox}"/>
        <ComboBox x:Name="OutputBox" Grid.Row="3" Margin="0,4,0,16" DisplayMemberPath="Name" TabIndex="0"
                  AutomationProperties.Name="Audio output"
                  AutomationProperties.HelpText="Choose an available Windows playback device by its friendly name."/>
        <Button x:Name="UseOutputButton" Grid.Row="4" Content="_Use selected output" FontSize="16"
                FontWeight="SemiBold" VerticalAlignment="Top" TabIndex="1" Click="UseOutputButton_Click"
                AutomationProperties.Name="Use selected audio output"
                AutomationProperties.HelpText="Makes the selected device the Windows default audio output."/>
        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Foreground="#D1D5DB"
                       Text="Loading audio outputs" AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Content="_Refresh" TabIndex="2" Click="RefreshButton_Click"
                    AutomationProperties.Name="Refresh audio outputs"/>
            <Button Grid.Column="2" Margin="10,0,0,0" Content="E_xit" TabIndex="3" Click="ExitButton_Click"
                    AutomationProperties.Name="Exit SwitchSound"
                    AutomationProperties.HelpText="Closes SwitchSound completely."/>
        </Grid>
    </Grid>
</Window>
